# Razorpay Test Mode credentials.
# Phase 1 never sends network requests. The sidebar reports "connected" when
# both values below are present, which is a statement about configuration, not
# about a verified handshake.
# Copy to `.env` and keep it out of version control.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Optional: webhook signing secret used to verify payment.failed events.
RAZORPAY_WEBHOOK_SECRET=

# Model provider for the AI Copilot. Left blank in Phase 1, which is why
# the Copilot composer renders a "not connected" state instead of a mock chat.
COPILOT_PROVIDER=
COPILOT_API_KEY=

# --- Local engine settings -------------------------------------------------

# Who the audit trail names for actions taken in the UI. There is no sign-in
# yet, so the trail records this desk rather than an anonymous "user".
REVIVEAI_OPERATOR=Ops Desk

# Merchant identity shown in the top bar. Defaults match the seeded UI, so the
# Rust engine and the browser preview never disagree about whose account this
# is. Mode is inferred from RAZORPAY_KEY_ID rather than set here.
REVIVEAI_MERCHANT_ID=acc_KLm3RtNvQz
REVIVEAI_MERCHANT_NAME=Kettle & Co.

# Where the SQLite store lives. Unset, it goes in the OS application data
# directory; set it to work against a throwaway database.
# REVIVEAI_DB_PATH=./.local/recovery.sqlite3

# On first run the engine ingests a small demo dataset so the dashboard opens
# populated. Every row is scored by the real rules engine and the seeding is
# recorded in the audit trail as `system.demo_seed`. Set to 0 to start empty.
REVIVEAI_DEMO_SEED=1

# Keep the seeded browser data while running the desktop shell. Useful for UI
# work before the engine is running; anything but `1` uses the Rust engine.
# VITE_FORCE_SEED=1
